{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "../context-pack/src",
    "outDir": "./dist/types/context-pack"
  },
  "include": [
    "../context-pack/src/bounded-json.ts",
    "../context-pack/src/canonical.ts",
    "../context-pack/src/scalars.ts",
    "../context-pack/src/knowledge-scope.ts",
    "../context-pack/src/knowledge-scope-admission.ts",
    "../context-pack/src/knowledge-scope-execution.ts",
    "../context-pack/src/knowledge-scope-batch.ts",
    "../context-pack/src/knowledge-scope-lock.ts",
    "../context-pack/src/knowledge-scope-mount.ts"
  ],
  "exclude": ["../context-pack/dist", "../context-pack/test"]
}
